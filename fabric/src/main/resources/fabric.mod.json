{
  "schemaVersion": 1,
  "id": "angelring",
  "version": "${version}",
  "name": "Angel Ring 3",
  "description": "Angel Ring 3 is a mod which adds a new ring into Minecraft. This ring allows you to fly like in a creative mode. Inspired by Extra Utilities 2.",
  "authors": [
    "DenisMasterHerobrine"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/angel-ring/",
    "sources": "https://github.com/DenisMasterHerobrine/AngelRing/"
  },
  "license": "LGPLv3",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.denismasterherobrine.angelring.fabric.AngelRingFabric"
    ],
    "client": [
      "dev.denismasterherobrine.angelring.fabric.client.AngelRingFabricClient"
    ]
  },
  "mixins": [
    "angelring.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": ">=1.21",
    "java": ">=21",
    "fabric-api": "*",
    "haydenapi": ">=1.0.0",
    "flightapi": ">=1.0.4",
    "trinkets": ">=3.10.0"
  }
}
